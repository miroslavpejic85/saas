# Environment configuration
NODE_ENV=development # development | production

# Server
PORT=3000
BASE_URL=http://localhost:3000

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Stripe (required)
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhooks (required for unlocking after payment)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Checkout mode
# - payment: one-time
# - subscription: recurring
STRIPE_MODE=payment

# Option A (recommended): Use a Stripe Price ID
# - For one-time: use a one-time price + STRIPE_MODE=payment
# - For recurring: use a recurring price + STRIPE_MODE=subscription
STRIPE_PRICE_ID=price_...

# Option B: Inline price_data (used ONLY if STRIPE_PRICE_ID is empty)
STRIPE_PRODUCT_NAME=Pro Access
STRIPE_CURRENCY=usd
STRIPE_UNIT_AMOUNT=1000 # integer in cents (e.g. 1000 = $10.00)

# Inline subscription extras (ONLY when STRIPE_MODE=subscription and STRIPE_PRICE_ID is empty)
STRIPE_RECURRING_INTERVAL=month # month|year
# STRIPE_RECURRING_INTERVAL_COUNT=1
